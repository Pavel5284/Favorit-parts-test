# Уникальный ключ покупателя (выдаёт Фаворит Моторс). Укажите свой.
# Ключ из примеров в документации — просто заглушка и, скорее всего, не рабочий.
VITE_API_KEY=ваш_ключ_покупателя

# Базовый адрес API (по умолчанию /api -> прокси из vite.config.js)
VITE_API_URL=/api

# Куда проксировать /api. Используется только в dev/preview, в браузер не попадает.
API_PROXY_TARGET=http://api.favorit-parts.ru
API_PROXY_PATH=/hs/hsprice/
